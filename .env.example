# Copy to `.env.local` (development) or set these in the deploy provider.
# Vite only exposes variables prefixed with VITE_ to the client bundle.

# Base URL used by the single Axios client. `/api` keeps requests same-origin so
# the MSW service worker can intercept them.
VITE_API_BASE_URL=/api

# Origin used by socket.io-client. Empty means "current origin".
VITE_SOCKET_URL=

# Boot MSW before the app renders. Must stay `true` for the demo deployment.
VITE_ENABLE_MOCKS=true

# Deterministic MSW scenario (see README → Cenários).
# default | slow | empty | flaky | session-expired | conflict | coupon-invalid
# price-changed | sold-out | order-timeout | payment-declined
VITE_MOCK_SCENARIO=default
